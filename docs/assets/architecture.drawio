          <mxGeometry x="10" y="280" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="eda_hpo" value="HPO Analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="eda_box">
          <mxGeometry x="105" y="280" width="95" height="30" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- INTER-LAYER ARROWS (between swimlanes) -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- Numerai API -> downloader -->
        <mxCell id="e_api_dl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="numerai_api" target="data_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Data layer -> config layer (dataset to runners) -->
        <mxCell id="e_data_cfg" value="NumeraiDataset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;fontSize=9;" edge="1" parent="1" source="data_layer" target="config_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Config layer -> pipeline layer -->
        <mxCell id="e_cfg_pipe" value="built pipeline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontSize=9;" edge="1" parent="1" source="config_layer" target="pipeline_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pipeline -> Evaluation -->
        <mxCell id="e_pipe_eval" value="predictions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;fontSize=9;" edge="1" parent="1" source="pipeline_layer" target="eval_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Evaluation -> Export -->
        <mxCell id="e_eval_exp" value="metrics + config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;fontSize=9;" edge="1" parent="1" source="eval_layer" target="export_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Submit -> Numerai API: routes in LEFT corridor (x=40), outside all swimlanes (x>=80) -->
        <mxCell id="e_submit_api" value="predictions upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="export_layer" target="numerai_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="940" />
              <mxPoint x="40" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Eval -> W&B: routes in RIGHT corridor (x=1600), between swimlanes (<=1580) and EDA (>=1620), then above all blocks -->
        <mxCell id="e_eval_wandb" value="metrics / XAI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval_layer" target="wandb_ext">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1600" y="795" />
              <mxPoint x="1600" y="50" />
              <mxPoint x="1445" y="50" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Data -> EDA: routes in RIGHT corridor (x=1605), between swimlanes and EDA, then enters EDA from left -->
        <mxCell id="e_data_eda" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="data_layer" target="eda_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1605" y="240" />
              <mxPoint x="1605" y="584" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- AutoResearch feedback loop arrow -->
        <mxCell id="e_ar_loop" value="mutate config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;dashed=1;fontSize=9;" edge="1" parent="1" source="ar_agent" target="hpo_obj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
